NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=mysql://user:password@127.0.0.1:4000/yellow_november
DB_POOL_SIZE=10
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Used only by `pnpm db:seed:admin`; use a strong secret outside source control.
ADMIN_NAME=Yellow November Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Cloudinary signed uploads. Keep the API secret on the backend only.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Deployment assumption: TiDB self-hosted/dedicated TCP via mysql2.
# For TiDB Cloud Serverless, replace the database adapter with the HTTP driver.
